{
  "schemaVersion": 1,
  "id": "strayarmor",
  "version": "${version}",
  "name": "StrayArmor",
  "description": "Tints player armor by your StrayTags own/ally/enemy/neutral category.",
  "authors": [
    "StrayArmor"
  ],
  "license": "MIT",
  "environment": "client",
  "entrypoints": {
    "client": [
      "io.github.bridge_noob.strayarmor.StrayArmorClient"
    ],
    "modmenu": [
      "io.github.bridge_noob.strayarmor.client.modmenu.StrayArmorModMenuIntegration"
    ]
  },
  "mixins": [
    "strayarmor.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=${loader_version}",
    "minecraft": "~${minecraft_version}",
    "java": ">=21",
    "fabric-api": ">=0.100.0"
  },
  "recommends": {
    "straytags": "*",
    "yet_another_config_lib_v3": ">=3.6",
    "modmenu": "*"
  }
}
